---
interface Props {
  updatedAt: string | null;
  thresholdHours: number;
  captureValid?: boolean;
  captureReason?: string;
  compact?: boolean;
  initializingMessage?: string;
}

const { updatedAt, thresholdHours, captureValid = true, captureReason = '', compact = false, initializingMessage = '正在等待首个真实快照。' } = Astro.props;
const formatted = updatedAt
  ? new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
    }).format(new Date(updatedAt))
  : null;
---

<aside
  class:list={['freshness-status', { compact, initializing: !updatedAt, warning: updatedAt && !captureValid }]}
  data-freshness
  data-updated-at={updatedAt ?? ''}
  data-threshold-hours={thresholdHours}
  aria-live="polite"
  aria-label="数据新鲜度"
>
  <span class="freshness-dot" aria-hidden="true"></span>
  <p data-freshness-message>
    {formatted ? (
      captureValid
        ? compact
          ? <>数据正常 · 最近采样 <time datetime={updatedAt ?? undefined}>{formatted}</time>（北京时间）</>
          : <>最近采样：<time datetime={updatedAt ?? undefined}>{formatted}</time>（北京时间）</>
        : <>候选池已于 <time datetime={updatedAt ?? undefined}>{formatted}</time> 采样，但不计入日榜基线（{captureReason || '不在零点有效窗口'}）。</>
    ) : initializingMessage}
  </p>
</aside>
<noscript><p class="noscript-note">数据新鲜度需要 JavaScript 动态判断，请同时核对页面显示的实际采样时间。</p></noscript>
