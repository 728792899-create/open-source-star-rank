---
import { withBase } from '../lib/paths';

interface Props {
  nextAt?: string | null;
  updatedAt?: string | null;
  indexPath: string;
  label?: string;
  announce?: boolean;
}

const { nextAt, updatedAt, indexPath, label = '下次数据更新', announce = true } = Astro.props;
const validNext = nextAt && !Number.isNaN(new Date(nextAt).getTime()) ? nextAt : null;
const formatted = validNext
  ? new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit',
    }).format(new Date(validNext))
  : null;
---

{validNext && <aside
  class="update-countdown"
  data-update-countdown
  data-next-at={validNext}
  data-updated-at={updatedAt ?? ''}
  data-index-path={withBase(indexPath)}
  aria-live={announce ? 'polite' : 'off'}
>
  <span class="update-countdown-label">{label}</span>
  <strong data-countdown-value>计算中…</strong>
  <time datetime={validNext}>计划 {formatted}（北京时间）</time>
  <button type="button" data-countdown-refresh hidden>新数据已发布，刷新查看</button>
</aside>}
